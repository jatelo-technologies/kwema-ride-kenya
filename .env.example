# =====================================================================
# Kwema Ride Kenya — environment
#
# On Railway, add the PostGIS and Redis services and reference their
# variables rather than pasting values:
#   DATABASE_URL = ${{postgis.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
# Railway injects PORT itself — do not set it.
# =====================================================================

NODE_ENV=production

# --- Country ---------------------------------------------------------
# One deployment serves one country. Drives phone format, currency, rounding,
# timezone, map bounds, wallets, languages and emergency numbers
# (src/common/country.ts). This folder's default is already KE.
COUNTRY=KE

# --- Database --------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/kwema
# Railway's managed Postgres presents its own CA; set true there, false locally.
DATABASE_SSL=true
DB_POOL_MAX=20

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://default:password@host:6379

# --- Administrator ---------------------------------------------------
# The account promoted to admin on every boot. Must be an existing, verified
# account — the person signs up in the app first, so the number is OTP-verified
# before it can administer anything. Revoking is a variable change, not a
# migration edit. Never commit a real number to the repo.
ADMIN_PHONE=+254XXXXXXXXX

# --- Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-min-32-chars
OFFER_TOKEN_SECRET=change-me-min-32-chars

# --- CORS / WebSocket origins ---------------------------------------
CORS_ORIGINS=https://admin.kwemaride.co.ke
WS_ALLOWED_ORIGINS=https://admin.kwemaride.co.ke

# --- WhatsApp (emergency alerts to a rider's or driver's contact) -----
# Needs a WhatsApp Business API provider: Meta Cloud API, or a reseller.
# Without these, emergency alerts still go out by SMS, and the apps and
# admin panel still offer one-tap wa.me links that open WhatsApp with the
# message pre-filled — those need no credentials at all.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# --- SMS (Africa's Talking, or another gateway licensed in Kenya.) ---
# The sender ID may need registering with the regulator or operator before
# messages deliver. Confirm with the chosen gateway.
# Leave SMS_API_URL unset in development: OTPs are printed to the log.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Mobile money: M-Pesa (Safaricom Daraja) ----------------------------
# From the Daraja portal (sandbox: https://sandbox.safaricom.co.ke, live:
# https://api.safaricom.co.ke). Collections use STK push; payouts use B2C.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for a paybill; CustomerBuyGoodsOnline for a till
# (then also set MPESA_PARTY_B to the till number).
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Long random string. It is placed in the callback URL (?t=...) because Daraja
# does not sign callbacks; the server also re-queries Safaricom before it
# marks anything paid.
MPESA_CALLBACK_TOKEN=
# Defaults to PUBLIC_BASE_URL. Safaricom rejects callback URLs containing the
# word "mpesa", so the routes use the slug "daraja".
MPESA_CALLBACK_BASE=
# Payouts (B2C) — leave blank to disable payouts for this wallet.
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Safaricom's public certificate (PEM, or base64 of it) that encrypts the
# initiator password.
MPESA_CERT_PEM=
MPESA_B2C_COMMAND=BusinessPayment

# --- Mobile money: Airtel Money -------------------------------------------
# From the Airtel Africa developer portal (https://developers.airtel.africa).
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# Long random string placed in the callback URL (?t=...); the server also
# re-queries Airtel before it marks anything paid.
AIRTEL_CALLBACK_TOKEN=
# Defaults to the country code and currency of this deployment.
AIRTEL_COUNTRY=
AIRTEL_CURRENCY=
# Payouts (disbursement) — leave blank to disable payouts for this wallet.
# The PIN is RSA-encrypted with Airtel's public key before it is sent.
AIRTEL_PIN=
AIRTEL_PUBLIC_KEY=
# pkcs1 (default) or oaep — use whichever Airtel's sandbox accepts.
AIRTEL_PIN_PADDING=pkcs1
# Override only if Airtel's current paths differ from the defaults.
AIRTEL_DISBURSE_PATH=
AIRTEL_DISBURSE_STATUS_PATH=

# --- Push notifications: Firebase Cloud Messaging --------------------
# The service-account key JSON (raw, or base64 of it) from the client's
# Firebase project: Project settings > Service accounts > Generate key.
FCM_SERVICE_ACCOUNT_JSON=

# --- Card payments ---------------------------------------------------
# DPO Pay is the default adapter (src/payments/card.provider.ts). Unverified
# against a live account.
# Sandbox: https://secure1.sandbox.directpay.online
DPO_BASE_URL=https://secure.3gdirectpay.com
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=

# The deployed https URL, no trailing slash. Used for 3-D Secure redirects and
# as the default base for mobile money callbacks.
PUBLIC_BASE_URL=https://kwema-ride-kenya-api.up.railway.app

# --- Maps ------------------------------------------------------------
# SERVER key: enable Directions, Distance Matrix, Geocoding, Places.
# Restrict it by IP to Railway's egress, never ship it in an APK — the
# mobile apps use a separate key restricted to the Maps SDK by bundle id.
GOOGLE_MAPS_SERVER_KEY=

# BROWSER key for the website's map. This one is public by design — it ships
# in the page — so it MUST be a different key from the server key above and
# MUST be restricted by HTTP referrer in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=

MAPBOX_ACCESS_TOKEN=

# --- App download links (shown on the website) -----------------------
# Leave blank until published; the site renders those as "coming soon"
# rather than dead links. The APK slot matters here: Play Store access is
# inconsistent on cheaper handsets and sideloading is normal.
RIDER_IOS_URL=
RIDER_ANDROID_URL=
RIDER_APK_URL=
DRIVER_IOS_URL=
DRIVER_ANDROID_URL=
DRIVER_APK_URL=

# --- In-app audio calls ------------------------------------------------
# Calls between a rider and their driver use WebRTC. Google STUN is built in.
# Behind some mobile carriers' NAT, calls only connect through a TURN relay —
# set one up (coturn, or a hosted TURN) and fill these in for reliable audio.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
